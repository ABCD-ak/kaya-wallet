<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kaya.mapper.CategoryMapper">

    <sql id="categoryColumns">
        id, code, type, name, icon, color, sort_order, is_active, created_at, updated_at
    </sql>

    <select id="findAll" resultType="com.kaya.entity.Category">
        SELECT <include refid="categoryColumns"/>
        FROM categories
        <where>
            is_active = 1
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
        </where>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultType="com.kaya.entity.Category">
        SELECT <include refid="categoryColumns"/>
        FROM categories
        WHERE id = #{id}
        LIMIT 1
    </select>

</mapper>
