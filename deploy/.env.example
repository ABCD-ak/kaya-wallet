# 复制为 deploy/.env 后填写；deploy/.env 已被 .gitignore 忽略
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# 至少 32 字节；可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-at-least-32-bytes-secret-key
SECURITY_FIELD_ENCRYPTION_KEY=change-me-at-least-32-bytes-encryption-key

# SMTP（QQ 邮箱使用 16 位授权码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=卡雅 Kaya
MAIL_SSL=true

# 前端重置密码页
APP_RESET_PASSWORD_URL=https://your-app.vercel.app/reset-password

# 允许跨域的前端来源（逗号分隔）
APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://*.pages.dev

# Caddy 站点地址；没有域名时用 <公网IP>.sslip.io 或 :80
SITE_ADDRESS=:80
