# syntax=docker/dockerfile:1
# 构建上下文为仓库根目录：docker build -f deploy/Dockerfile.backend .

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

# 先复制 pom 以复用依赖缓存
COPY kaya-backend/pom.xml ./pom.xml
RUN mvn -B -ntp dependency:go-offline

COPY kaya-backend/src ./src
# 仓库不含真实配置，镜像内使用模板；运行时由环境变量覆盖
RUN cp src/main/resources/application.properties.example src/main/resources/application.properties \
    && mvn -B -ntp package -DskipTests

FROM tomcat:10.1-jdk17-temurin
RUN rm -rf /usr/local/tomcat/webapps/* \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/uploads/avatars

COPY --from=build /build/target/api.war /usr/local/tomcat/webapps/api.war

ENV JAVA_OPTS="-Xms256m -Xmx512m -Dfile.encoding=UTF-8"
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1
